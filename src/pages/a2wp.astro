---
import Base from '../layouts/Base.astro';
import A2wpDemo from '../components/A2wpDemo.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { url } from '../lib/url';

const draft = 'https://www.ietf.org/archive/id/draft-senarath-a2wp-01.html';
const poc = 'https://github.com/shashimalcse/agent-vc-poc';

const problems = [
  {
    hue: 'coral',
    title: 'API keys say nothing',
    body: 'Agents prove who they are with a separate API key for every service. A key does not say who made the agent, who runs it or whether anyone checked it, and anyone who copies one <b>becomes the agent</b>.',
    sample: ['tickets.example: sk_live_9f2…', 'rail.example:    rk_7Hq0…', 'grocer.example:  gk_3Lm8…'],
  },
  {
    hue: 'violet',
    title: 'Agents mishandle credentials',
    body: 'Given a credential offer link and no wallet, an agent we tested tried to open it like a web page. Put a credential or key in its context and the model can read it, log it, or be tricked into <b>sending it somewhere else</b>.',
    sample: ['agent: open openid-credential-offer://…', '  ✕ not a web page', 'context: { sd_jwt: eyJhbGci… }'],
  },
  {
    hue: 'cobalt',
    title: 'Wallets have no agent interface',
    body: 'OpenID4VCI and OpenID4VP connect wallets to issuers and verifiers, but they assume a person at the device. Nothing standard lets an agent <b>ask a wallet to act</b> for it, so every pairing is custom.',
    sample: ['agent → wallet: collect this?', 'agent → wallet: present this?', '  no standard way to ask'],
  },
];

interface Sequence {
  id: string;
  tab: string;
  title: string;
  steps: {
    title: string;
    body: string;
    code?: { title: string; lang: 'json' | 'http'; code: string }[];
    checklist?: string[];
  }[];
}

const sequences: Sequence[] = [
  {
    id: 'issuance',
    tab: 'Acquire',
    title: 'Acquire a credential',
    steps: [
      {
        title: 'The agent hands its wallet the offer',
        body: 'An issuer gave the agent a credential offer link. The agent submits it to its wallet exactly as it got it and never opens it itself. The wallet works out that it is an offer and replies at once with an operation to follow. Submitting the same link again returns the same operation, so a retry cannot redeem it twice.',
        code: [
          {
            title: 'Submit',
            lang: 'json',
            code: `{
  "request": "openid-credential-offer://?credential_offer_uri=https%3A%2F%2Fissuer.example%2Foffers%2F9c1e"
}`,
          },
          {
            title: 'Operation',
            lang: 'json',
            code: `{
  "id": "op_Qm7cZt0sLe…",
  "status": "pending"
}`,
          },
        ],
      },
      {
        title: 'The wallet runs OpenID4VCI',
        body: 'The wallet talks to the issuer itself. The agent never sees a token, a key or the credential.',
        checklist: [
          "Loads the offer and the issuer's metadata",
          'Checks the issuer and credential type against policy, before redeeming anything',
          "Asks the user for a transaction code on the wallet's own page, never through the agent",
          'Redeems the pre-authorized code',
          'Creates a fresh holder key and proves it controls it',
          'Verifies the SD-JWT VC: issuer signature, chain, type and holder binding',
          'Stores the credential with the agent that asked for it',
        ],
      },
      {
        title: 'The agent learns the outcome',
        body: 'When the operation completes, that is all the agent learns. The credential stays in the wallet, ready for the next request. An issuance has no continuation, so the agent carries on with its task.',
        code: [
          {
            title: 'Operation',
            lang: 'json',
            code: `{
  "id": "op_Qm7cZt0sLe…",
  "status": "completed"
}`,
          },
        ],
      },
    ],
  },
  {
    id: 'presentation',
    tab: 'Present',
    title: 'Present a credential',
    steps: [
      {
        title: 'The agent hands its wallet the request',
        body: "A site showed the agent a presentation request, for example as an Open in wallet link at sign-in. The agent submits the link to its wallet unchanged, the same call it uses for offers, and gets an operation back.",
        code: [
          {
            title: 'Submit',
            lang: 'json',
            code: `{
  "request": "openid4vp://authorize?client_id=x509_san_dns%3Atickets.example&request_uri=https%3A%2F%2Ftickets.example%2Frequest%2F7f3a"
}`,
          },
          {
            title: 'Operation',
            lang: 'json',
            code: `{
  "id": "op_4Tk9xQ2mVb…",
  "status": "pending"
}`,
          },
        ],
      },
      {
        title: 'The wallet runs OpenID4VP',
        body: "Everything that touches the credential happens inside the wallet, out of the agent's reach.",
        checklist: [
          "Fetches the verifier's signed request and checks its certificate chain",
          "Checks that the certificate names the verifier's client_id",
          "Runs the DCQL query against this agent's credentials only",
          'Applies policy: may this agent share these claims with this verifier?',
          'Builds a minimal disclosure plus a key-binding JWT for this verifier',
          'Posts the response straight to the verifier, not through the agent',
        ],
      },
      {
        title: 'Sometimes, a person decides',
        body: "Whether to ask the user is the wallet's policy: for example a first visit to a site, more claims than last time, or an unfamiliar issuer. The operation stays pending and carries an interaction. The agent passes the link to its user and keeps checking the operation until it finishes. It never opens the link, and the wallet's page signs the user in rather than trusting whoever holds the link.",
        code: [
          {
            title: 'Operation',
            lang: 'json',
            code: `{
  "id": "op_4Tk9xQ2mVb…",
  "status": "pending",
  "interaction": {
    "uri": "https://wallet.example/approve/ia_Acw…",
    "expires_at": "2026-10-13T09:40:00Z"
  }
}`,
          },
        ],
      },
      {
        title: 'The agent picks up where it left off',
        body: "The verifier answers the wallet with a continuation, and the wallet passes it to the agent unchanged. The agent opens it in the browser session where it found the request, and the site carries on with the checkout. What was disclosed went only to the verifier.",
        code: [
          {
            title: 'Operation',
            lang: 'json',
            code: `{
  "id": "op_4Tk9xQ2mVb…",
  "status": "completed",
  "continuation": "https://tickets.example/checkout/chk_MJnD?response_code=0915…"
}`,
          },
        ],
      },
    ],
  },
];

const bindings = [
  {
    name: 'MCP',
    body: 'The wallet is an MCP server and each call is a tool, so any MCP-capable agent can use it with no extra code. The PoC ran an earlier version of this with a real agent.',
    lines: ['submit(request)', 'get(id, wait_seconds)', 'cancel(id)'],
  },
  {
    name: 'HTTPS',
    body: 'The same three calls as HTTP resources, for agents and services that do not speak MCP.',
    lines: ['POST   /operations', 'GET    /operations/{id}', 'DELETE /operations/{id}'],
  },
];

const uses = [
  {
    title: 'Agents with their own ID',
    body: 'An agent carries a credential that says who it is and who runs it, from a registry that vouches for it, and signs in to any site that trusts the registry.',
    href: '/writing/an-agent-with-its-own-credential/',
    link: 'Read the story',
  },
  {
    title: 'Personal assistants',
    body: 'Your agent proves things about you, such as your age, with a credential you delegate from your own wallet for that one presentation. It never sees the credential behind the proof.',
  },
  {
    title: 'Enterprise agents',
    body: "Each agent gets its own access to the wallet and its own credentials. People approve where policy says so, and one policy covers them all.",
  },
];
---

<Base title="A2WP" description="A2WP, the Agent-to-Wallet Protocol: how an AI agent asks a credential wallet to act for it." glow>
  <section slot="top" class="container head">
    <p class="chips">
      <span class="chip">Internet-Draft</span>
      <span class="chip chip--id">draft-senarath-a2wp-01</span>
    </p>
    <h1>Agents use credentials. Wallets hold them.</h1>
    <p class="lede">
      The Agent-to-Wallet Protocol (A2WP) lets an AI agent ask its wallet to collect or present credentials, its own
      or ones it was given, while the wallet keeps the keys, the policy and the final say. It is independent of the
      transport, so it works over MCP, HTTPS or anything else.
    </p>
    <div class="actions">
      <a href="#how" class="btn btn--primary">How A2WP works</a>
      <a href={draft} class="btn btn--secondary">Read the draft</a>
    </div>
  </section>

  <!-- Problem -->
  <section class="section section--first">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The problem</p>
          <h2 class="h-section">Agents need credentials. There is no safe way to hand them one.</h2>
        </div>
      </div>
      <div class="problems">
        {
          problems.map((p) => (
            <article style={`--hue: var(--${p.hue}); --tint: var(--${p.hue}-tint)`}>
              <pre class="problems__sample" aria-hidden="true">{p.sample.join('\n')}</pre>
              <h3>
                <span class="problems__x" aria-hidden="true">✕</span>
                {p.title}
              </h3>
              <p set:html={p.body} />
            </article>
          ))
        }
      </div>
      <p class="pivot">
        A2WP splits the job in two. <b>The agent says what it needs. The wallet decides and does it.</b>
      </p>
    </div>
  </section>

  <!-- Overview animation -->
  <section id="how" class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">How A2WP works</p>
          <h2 class="h-section">Two operations, one rule.</h2>
        </div>
        <p>The agent hands its wallet an offer or a request, exactly as it got it. The wallet works out which, does the work, and the agent only learns the outcome.</p>
      </div>
      <A2wpDemo />
    </div>
  </section>

  <!-- Steps with real messages -->
  <section class="section" data-sequences>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Under the hood</p>
          <h2 class="h-section">Step by step.</h2>
        </div>
        <p>An operation looks the same over every binding. Each call is authenticated as one agent, and that agent's credentials and policy apply. Long values are shortened.</p>
      </div>

      <div class="seq-tabs" role="group" aria-label="Choose a flow" hidden data-seq-tabs>
        {
          sequences.map((q, i) => (
            <button type="button" data-seq-pick={q.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {q.tab}
            </button>
          ))
        }
      </div>

      {
        sequences.map((q) => (
          <div class="seq" data-seq={q.id}>
            <h3 class="seq__title">{q.title}</h3>
            <ol class="steps">
              {q.steps.map((st, i) => (
                <li class="steps__item">
                  <div class="steps__text">
                    <span class="steps__n">{i + 1}</span>
                    <h4>{st.title}</h4>
                    <p>{st.body}</p>
                  </div>
                  <div class="steps__code">
                    {st.code?.map((c) => (
                      <CodeBlock lang={c.lang} title={c.title} code={c.code} />
                    ))}
                    {st.checklist && (
                      <ul class="checklist">
                        {st.checklist.map((w) => (
                          <li>
                            <span class="checklist__tick" aria-hidden="true">✓</span>
                            {w}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <script>
    // Without JavaScript both sequences show, one after the other.
    document.querySelectorAll<HTMLElement>('[data-sequences]').forEach((root) => {
      const tabs = root.querySelector<HTMLElement>('[data-seq-tabs]')!;
      const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[data-seq-pick]')];
      const seqs = [...root.querySelectorAll<HTMLElement>('[data-seq]')];
      const pick = (id: string) => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.seqPick === id)));
        seqs.forEach((s) => (s.hidden = s.dataset.seq !== id));
      };
      tabs.hidden = false;
      root.classList.add('has-tabs');
      buttons.forEach((b) => b.addEventListener('click', () => pick(b.dataset.seqPick!)));
      pick(buttons[0].dataset.seqPick!);
    });
  </script>

  <!-- Bindings -->
  <section class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Bindings</p>
          <h2 class="h-section">The draft defines the calls, not the transport.</h2>
        </div>
        <p>A binding carries the three calls and decides how the wallet authenticates each agent, for example with a bearer key or DPoP. These two are sketches; neither is part of -01.</p>
      </div>
      <div class="bindings">
        {
          bindings.map((b) => (
            <article>
              <h3>{b.name}</h3>
              <p>{b.body}</p>
              <pre>{b.lines.join('\n')}</pre>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Where it fits -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h-section">Where A2WP fits</h2>
      </div>
      <div class="uses">
        {
          uses.map((u) => (
            <article>
              <h3>{u.title}</h3>
              <p>{u.body}</p>
              {u.href && (
                <a href={url(u.href)} class="uses__link">
                  {u.link} <span aria-hidden="true">→</span>
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h-section resources__title">Learn more</h2>
      <div class="link-list resources">
        <a href={draft}>
          <span><b>The draft</b><span>draft-senarath-a2wp-01 on the IETF archive</span></span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={poc}>
          <span><b>Agent-credential PoC</b><span>A Kotlin wallet on the EUDI libraries, served over MCP, with walt.id's issuer and verifier and a real OpenClaw agent. It was built against -00.</span></span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={url('/writing/agent-credential-under-the-hood/')}>
          <span><b>Under the hood</b><span>An agent signs in with its own credential, in eight interaction points</span></span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={url('/specs/')}>
          <span><b>Related specs</b><span>OpenID4VCI, OpenID4VP, SD-JWT VC and more</span></span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bindings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .bindings article {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
  }
  .bindings h3 {
    margin: 0 0 6px;
    font-size: 20px;
    font-weight: 600;
  }
  .bindings p {
    margin: 0 0 16px;
    color: var(--text);
  }
  .bindings pre {
    margin: 0;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--code-bg);
    color: #e6e6ea;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
  }
  .uses__link {
    display: inline-block;
    margin-top: 10px;
    font-weight: 500;
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .bindings {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .head {
    position: relative;
    padding-top: 80px;
    padding-bottom: 72px;
  }
  .chips {
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid #d9d9de;
    background: rgb(255 255 255 / 0.8);
    font-family: var(--mono);
    font-size: 12px;
  }
  .chip--id {
    border-color: transparent;
    background: var(--ink);
    color: #fff;
  }
  h1 {
    margin: 0;
    max-width: 900px;
    font-size: clamp(38px, 5.2vw, 64px);
    line-height: 1.04;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .lede {
    margin-top: 24px;
    max-width: 680px;
  }
  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .section--first {
    border-top: 1px solid var(--line);
  }

  /* Problem */
  .problems {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .problems article {
    padding: 0 0 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
  }
  .problems__sample {
    margin: 0 0 20px;
    padding: 18px 20px;
    background: var(--tint);
    color: color-mix(in srgb, var(--hue) 70%, black);
    font-size: 12.5px;
    line-height: 1.7;
    white-space: pre;
    overflow-x: auto;
  }
  .problems h3 {
    margin: 0 24px 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 600;
  }
  .problems__x {
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 99px;
    background: var(--hue);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
  }
  .problems p {
    margin: 0 24px;
    font-size: 15px;
    color: var(--text);
  }
  .problems p :global(b) {
    font-weight: 600;
    color: var(--ink);
  }
  .pivot {
    margin: 40px 0 0;
    font-size: 20px;
    color: var(--text);
  }
  .pivot b {
    color: var(--ink);
    font-weight: 600;
  }

  /* Steps */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px 56px;
    padding: 0 0 56px 56px;
  }
  /* A rail joins the step numbers. */
  .steps__item::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 40px;
    bottom: 0;
    border-left: 1.5px dashed #d9d9de;
  }
  .steps__item:last-child::before {
    display: none;
  }
  .steps__n {
    position: absolute;
    left: 0;
    top: 0;
    width: 36px;
    height: 36px;
    border-radius: 99px;
    background: var(--ink);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 14px;
  }
  .seq-tabs {
    display: flex;
    gap: 6px;
    margin-bottom: 40px;
  }
  .seq-tabs[hidden] {
    display: none;
  }
  .seq-tabs button {
    min-height: 40px;
    padding: 0 18px;
    border: 1px solid #d9d9de;
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    cursor: pointer;
  }
  .seq-tabs button[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }
  .seq + .seq {
    margin-top: 24px;
  }
  .seq__title {
    margin: 0 0 32px;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .has-tabs .seq__title {
    display: none;
  }
  .steps__text h4 {
    margin: 4px 0 10px;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .steps__text p {
    margin: 0;
    color: var(--text);
  }
  .steps__code {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .checklist {
    list-style: none;
    margin: 0;
    padding: 8px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
  }
  .checklist li {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 15px;
  }
  .checklist li:last-child {
    border-bottom: 0;
  }
  .checklist__tick {
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 99px;
    background: var(--teal);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
  }

  /* Uses */
  .uses {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .uses article {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .uses h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
  }
  .uses p {
    margin: 0;
    font-size: 15px;
    color: var(--text);
  }

  .resources__title {
    margin-bottom: 32px;
  }
  .resources a {
    padding: 18px 0;
  }
  .resources a > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .resources b {
    font-weight: 600;
  }
  .resources a > span:first-child > span {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .problems,
    .uses {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps__item {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .steps__item {
      padding-left: 48px;
    }
  }
</style>
