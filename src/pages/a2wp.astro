---
import Base from '../layouts/Base.astro';
import A2wpDemo from '../components/A2wpDemo.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { url } from '../lib/url';

const draft = 'https://www.ietf.org/archive/id/draft-senarath-a2wp-00.html';
const repo = 'https://github.com/shashimalcse/a2wp';

const problems = [
  {
    hue: 'coral',
    title: 'Secrets in the prompt',
    body: 'Agents get a token, key or credential pasted into their context. The model can read it, log it, or be tricked into sending it somewhere else.',
    sample: ['context:', '  api_key: sk_live_9f2…', '  id_card: { name, dob, … }'],
  },
  {
    hue: 'violet',
    title: 'The agent as the wallet',
    body: 'Or the agent holds the keys and decides what to disclose. A prompt injection is then one step away from your private claims.',
    sample: ['agent:', '  holds: private keys', '  decides: what to share'],
  },
  {
    hue: 'cobalt',
    title: 'Wallets have no agent interface',
    body: "OpenID4VCI and OpenID4VP connect wallets to issuers and verifiers, and links or the browser's Digital Credentials API assume a person at the device. Nothing standard lets an agent <b>ask a wallet to act</b> for it, so every pairing is custom. Discovering a wallet and authenticating to it are missing too.",
    sample: ['agent → wallet: acquire this?', 'agent → wallet: present this?', '  no standard way to ask'],
  },
];

const headers = `POST /operations HTTP/1.1
Host: wallet.example
Authorization: DPoP eyJ0eXAiOiJhdCtqd3Qi…
DPoP: eyJ0eXAiOiJkcG9wK2p3dCIs…
Content-Type: application/json`;

interface Sequence {
  id: string;
  tab: string;
  title: string;
  steps: {
    title: string;
    body: string;
    code?: { title: string; lang: 'json' | 'http'; code: string }[];
    checklist?: string[];
  }[];
}

const sequences: Sequence[] = [
  {
    id: 'issuance',
    tab: 'Issuance',
    title: 'Acquire a credential',
    steps: [
      {
        title: 'The agent asks the wallet to accept an offer',
        body: 'An issuer gave the agent a credential offer link. The agent passes it to the wallet and says why. The wallet replies at once with an operation to follow.',
        code: [
          {
            title: 'Create an operation',
            lang: 'http',
            code: `${headers}

{
  "operation": "acquire",
  "protocol": "openid4vci",
  "request": {
    "credential_offer_uri": "https://issuer.example/offers/9c1e"
  },
  "context": { "purpose": "Store my membership card" }
}`,
          },
          {
            title: 'Accepted',
            lang: 'http',
            code: `HTTP/1.1 202 Accepted
Location: https://wallet.example/operations/op_Qm7cZt0sLe…
Retry-After: 1

{
  "operation_id": "op_Qm7cZt0sLe…",
  "operation": "acquire",
  "protocol": "openid4vci",
  "status": "pending",
  "status_uri": "https://wallet.example/operations/op_Qm7cZt0sLe…"
}`,
          },
        ],
      },
      {
        title: 'The wallet runs OpenID4VCI',
        body: 'The wallet talks to the issuer itself. The agent never sees a token, a key or the credential.',
        checklist: [
          "Loads the offer, then the issuer's and authorization server's metadata",
          'Checks the issuer and credential type against policy',
          'Redeems the pre-authorized code',
          'Creates a fresh holder key and proves it controls it',
          "Verifies the SD-JWT VC: issuer key, type, and binding to the holder key",
          'Commits, then stores the credential',
        ],
      },
      {
        title: 'The agent gets a handle',
        body: 'When the operation completes, the agent gets an opaque handle and the properties its policy allows it to see. Never the credential itself.',
        code: [
          {
            title: 'Operation status',
            lang: 'json',
            code: `{
  "operation_id": "op_Qm7cZt0sLe…",
  "operation": "acquire",
  "status": "completed",
  "result": {
    "credentials": [{
      "credential_handle": "cred_Jx8vR1…",
      "properties": {
        "vct": "urn:example:a2wp:membership",
        "iss": "https://issuer.example"
      }
    }]
  }
}`,
          },
        ],
      },
    ],
  },
  {
    id: 'presentation',
    tab: 'Presentation',
    title: 'Present a credential',
    steps: [
      {
        title: 'The agent asks the wallet to answer a verifier',
        body: "A verifier gave the agent a presentation request. The agent copies the verifier's request into request, unchanged, and says why.",
        code: [
          {
            title: 'Create an operation',
            lang: 'http',
            code: `${headers}

{
  "operation": "present",
  "protocol": "openid4vp",
  "request": {
    "client_id": "x509_san_dns:verifier.example",
    "request_uri": "https://verifier.example/request/7f3a",
    "request_uri_method": "post"
  },
  "context": { "purpose": "Prove membership" }
}`,
          },
          {
            title: 'Accepted',
            lang: 'http',
            code: `HTTP/1.1 202 Accepted
Location: https://wallet.example/operations/op_4Tk9xQ2mVb…
Retry-After: 1

{
  "operation_id": "op_4Tk9xQ2mVb…",
  "operation": "present",
  "protocol": "openid4vp",
  "status": "pending",
  "status_uri": "https://wallet.example/operations/op_4Tk9xQ2mVb…"
}`,
          },
        ],
      },
      {
        title: 'The wallet runs OpenID4VP',
        body: "Everything that touches the credential happens inside the wallet, out of the agent's reach.",
        checklist: [
          "Fetches the verifier's signed request and checks its certificate chain",
          'Confirms the client_id and response URI agree',
          'Runs the DCQL query against the credentials it holds',
          'Applies policy: may this agent share these claims with this verifier?',
          'Builds a minimal disclosure plus a key-binding JWT for this verifier',
          'Commits, then posts the response straight to the verifier',
        ],
      },
      {
        title: 'The agent learns the outcome',
        body: 'A presentation returns no result at all. What was disclosed went only to the verifier.',
        code: [
          {
            title: 'Operation status',
            lang: 'json',
            code: `{
  "operation_id": "op_4Tk9xQ2mVb…",
  "operation": "present",
  "status": "completed",
  "completed_at": "2026-10-07T10:15:03Z"
}`,
          },
        ],
      },
    ],
  },
];

const uses = [
  {
    title: 'Personal assistants',
    body: 'Your agent proves things about you, such as your age or employer, without ever seeing the credential behind the proof.',
  },
  {
    title: 'Agents over MCP',
    body: 'Any MCP-capable agent can use a wallet through an adapter. The model only ever sees operation ids and statuses.',
  },
  {
    title: 'Enterprise agents',
    body: "An organisation's agents acquire and present credentials under one wallet policy, with every operation tied to the agent and user that asked for it.",
  },
];
---

<Base title="A2WP" description="A2WP, the Agent-to-Wallet Protocol: how an AI agent asks a credential wallet to act for it." glow>
  <section slot="top" class="container head">
    <p class="chips">
      <span class="chip">Internet-Draft</span>
      <span class="chip chip--id">draft-senarath-a2wp-00</span>
    </p>
    <h1>Agents use credentials. Wallets hold them.</h1>
    <p class="lede">
      The Agent-to-Wallet Protocol (A2WP) lets an AI agent ask a credential wallet to acquire or present credentials,
      while the wallet keeps the keys, the policy and the final say.
    </p>
    <div class="actions">
      <a href="#how" class="btn btn--primary">How A2WP works</a>
      <a href={draft} class="btn btn--secondary">Read the draft</a>
    </div>
  </section>

  <!-- Problem -->
  <section class="section section--first">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The problem</p>
          <h2 class="h-section">Agents need credentials. There is no safe way to hand them one.</h2>
        </div>
      </div>
      <div class="problems">
        {
          problems.map((p) => (
            <article style={`--hue: var(--${p.hue}); --tint: var(--${p.hue}-tint)`}>
              <pre class="problems__sample" aria-hidden="true">{p.sample.join('\n')}</pre>
              <h3>
                <span class="problems__x" aria-hidden="true">✕</span>
                {p.title}
              </h3>
              <p set:html={p.body} />
            </article>
          ))
        }
      </div>
      <p class="pivot">
        A2WP splits the job in two. <b>The agent says what it needs. The wallet decides and does it.</b>
      </p>
    </div>
  </section>

  <!-- Overview animation -->
  <section id="how" class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">How A2WP works</p>
          <h2 class="h-section">Two operations, one rule.</h2>
        </div>
        <p>The agent can ask the wallet to acquire a credential or to present one. Either way, the wallet does the work and the agent only learns the outcome.</p>
      </div>
      <A2wpDemo />
    </div>
  </section>

  <!-- Steps with real messages -->
  <section class="section" data-sequences>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Under the hood</p>
          <h2 class="h-section">Step by step.</h2>
        </div>
        <p>Messages as the reference wallet sends them. Long values are shortened.</p>
      </div>

      <div class="seq-tabs" role="group" aria-label="Choose a flow" hidden data-seq-tabs>
        {
          sequences.map((q, i) => (
            <button type="button" data-seq-pick={q.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {q.tab}
            </button>
          ))
        }
      </div>

      {
        sequences.map((q) => (
          <div class="seq" data-seq={q.id}>
            <h3 class="seq__title">{q.title}</h3>
            <ol class="steps">
              {q.steps.map((st, i) => (
                <li class="steps__item">
                  <div class="steps__text">
                    <span class="steps__n">{i + 1}</span>
                    <h4>{st.title}</h4>
                    <p>{st.body}</p>
                  </div>
                  <div class="steps__code">
                    {st.code?.map((c) => (
                      <CodeBlock lang={c.lang} title={c.title} code={c.code} />
                    ))}
                    {st.checklist && (
                      <ul class="checklist">
                        {st.checklist.map((w) => (
                          <li>
                            <span class="checklist__tick" aria-hidden="true">✓</span>
                            {w}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <script>
    // Without JavaScript both sequences show, one after the other.
    document.querySelectorAll<HTMLElement>('[data-sequences]').forEach((root) => {
      const tabs = root.querySelector<HTMLElement>('[data-seq-tabs]')!;
      const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[data-seq-pick]')];
      const seqs = [...root.querySelectorAll<HTMLElement>('[data-seq]')];
      const pick = (id: string) => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.seqPick === id)));
        seqs.forEach((s) => (s.hidden = s.dataset.seq !== id));
      };
      tabs.hidden = false;
      root.classList.add('has-tabs');
      buttons.forEach((b) => b.addEventListener('click', () => pick(b.dataset.seqPick!)));
      pick(buttons[0].dataset.seqPick!);
    });
  </script>

  <!-- Where it fits -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h-section">Where A2WP fits</h2>
      </div>
      <div class="uses">
        {
          uses.map((u) => (
            <article>
              <h3>{u.title}</h3>
              <p>{u.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h-section resources__title">Learn more</h2>
      <div class="link-list resources">
        <a href={draft}>
          <span><b>The draft</b><span>draft-senarath-a2wp-00 on the IETF archive</span></span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={repo}>
          <span><b>Reference wallet</b><span>Go, standard library only, with an Agent SDK and an MCP adapter. Apache-2.0.</span></span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={`${repo}/blob/main/docs/conformance.md`}>
          <span><b>Conformance notes</b><span>Gaps found while implementing the draft, feeding the next revision</span></span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={url('/specs/')}>
          <span><b>Related specs</b><span>OpenID4VCI, OpenID4VP, SD-JWT VC and more</span></span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    position: relative;
    padding-top: 80px;
    padding-bottom: 72px;
  }
  .chips {
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid #d9d9de;
    background: rgb(255 255 255 / 0.8);
    font-family: var(--mono);
    font-size: 12px;
  }
  .chip--id {
    border-color: transparent;
    background: var(--ink);
    color: #fff;
  }
  h1 {
    margin: 0;
    max-width: 900px;
    font-size: clamp(38px, 5.2vw, 64px);
    line-height: 1.04;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .lede {
    margin-top: 24px;
    max-width: 680px;
  }
  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .section--first {
    border-top: 1px solid var(--line);
  }

  /* Problem */
  .problems {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .problems article {
    padding: 0 0 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
  }
  .problems__sample {
    margin: 0 0 20px;
    padding: 18px 20px;
    background: var(--tint);
    color: color-mix(in srgb, var(--hue) 70%, black);
    font-size: 12.5px;
    line-height: 1.7;
    white-space: pre;
    overflow-x: auto;
  }
  .problems h3 {
    margin: 0 24px 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 600;
  }
  .problems__x {
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 99px;
    background: var(--hue);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
  }
  .problems p {
    margin: 0 24px;
    font-size: 15px;
    color: var(--text);
  }
  .problems p :global(b) {
    font-weight: 600;
    color: var(--ink);
  }
  .pivot {
    margin: 40px 0 0;
    font-size: 20px;
    color: var(--text);
  }
  .pivot b {
    color: var(--ink);
    font-weight: 600;
  }

  /* Steps */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px 56px;
    padding: 0 0 56px 56px;
  }
  /* A rail joins the step numbers. */
  .steps__item::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 40px;
    bottom: 0;
    border-left: 1.5px dashed #d9d9de;
  }
  .steps__item:last-child::before {
    display: none;
  }
  .steps__n {
    position: absolute;
    left: 0;
    top: 0;
    width: 36px;
    height: 36px;
    border-radius: 99px;
    background: var(--ink);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 14px;
  }
  .seq-tabs {
    display: flex;
    gap: 6px;
    margin-bottom: 40px;
  }
  .seq-tabs[hidden] {
    display: none;
  }
  .seq-tabs button {
    min-height: 40px;
    padding: 0 18px;
    border: 1px solid #d9d9de;
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    cursor: pointer;
  }
  .seq-tabs button[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }
  .seq + .seq {
    margin-top: 24px;
  }
  .seq__title {
    margin: 0 0 32px;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .has-tabs .seq__title {
    display: none;
  }
  .steps__text h4 {
    margin: 4px 0 10px;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .steps__text p {
    margin: 0;
    color: var(--text);
  }
  .steps__code {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .checklist {
    list-style: none;
    margin: 0;
    padding: 8px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
  }
  .checklist li {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 15px;
  }
  .checklist li:last-child {
    border-bottom: 0;
  }
  .checklist__tick {
    width: 22px;
    height: 22px;
    flex: none;
    border-radius: 99px;
    background: var(--teal);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
  }

  /* Uses */
  .uses {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .uses article {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .uses h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
  }
  .uses p {
    margin: 0;
    font-size: 15px;
    color: var(--text);
  }

  .resources__title {
    margin-bottom: 32px;
  }
  .resources a {
    padding: 18px 0;
  }
  .resources a > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .resources b {
    font-weight: 600;
  }
  .resources a > span:first-child > span {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .problems,
    .uses {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps__item {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .steps__item {
      padding-left: 48px;
    }
  }
</style>
