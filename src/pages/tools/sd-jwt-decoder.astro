---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

const description = 'Decode an SD-JWT and see which claims it discloses. Runs entirely in your browser.';
const home = new URL(url('/'), Astro.site).href;
const app = {
  '@type': 'WebApplication',
  '@id': `${new URL(Astro.url.pathname, Astro.site).href}#app`,
  name: 'SD-JWT decoder',
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (runs in the browser)',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@id': `${home}#author` },
};
---

<Base title="SD-JWT decoder" description={description} schema={[app]}>
  <div slot="top" class="container head">
    <div>
      <p class="eyebrow">Tool</p>
      <h1>SD-JWT decoder</h1>
    </div>
    <p class="head__privacy">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
      Decoded locally. Nothing leaves your browser.
    </p>
  </div>

  <section class="container tool" data-decoder>
    <div class="tool__input">
      <div class="tool__bar">
        <label for="sdjwt">Encoded SD-JWT</label>
        <div class="tool__buttons">
          <button type="button" class="small-btn" data-example>Load example</button>
          <button type="button" class="small-btn" data-clear>Clear</button>
        </div>
      </div>
      <textarea id="sdjwt" spellcheck="false" autocomplete="off" placeholder="eyJhbGciOi…~WyJzYWx0Ii…~"></textarea>
      <p class="tool__note">Decodes only. Signatures are not verified.</p>
    </div>

    <div class="tool__output" aria-live="polite">
      <p class="tool__status" data-status>Paste an SD-JWT, or load the example.</p>
      <ul class="tool__warnings" data-warnings></ul>

      <div class="panel" data-panel="claims" hidden>
        <div class="panel__head"><span>Disclosed claims</span><span>what the verifier sees</span></div>
        <pre data-out="claims"></pre>
      </div>

      <div class="panel" data-panel="disclosures" hidden>
        <div class="panel__head"><span>Disclosures</span><span data-out="disclosure-count"></span></div>
        <div class="panel__scroll">
          <table>
            <thead>
              <tr><th scope="col">Claim</th><th scope="col">Value</th><th scope="col">Salt</th><th scope="col">Matched</th></tr>
            </thead>
            <tbody data-out="disclosures"></tbody>
          </table>
        </div>
      </div>

      <div class="panel" data-panel="header" hidden>
        <div class="panel__head"><span>Header</span><span>JOSE</span></div>
        <pre data-out="header"></pre>
      </div>

      <div class="panel" data-panel="payload" hidden>
        <div class="panel__head"><span>Payload</span><span>as signed by the issuer</span></div>
        <pre data-out="payload"></pre>
      </div>

      <div class="panel" data-panel="kb" hidden>
        <div class="panel__head"><span>Key-binding JWT</span><span>signed by the holder</span></div>
        <pre data-out="kb"></pre>
      </div>
    </div>
  </section>
</Base>

<script>
  import { decodeSdJwt, exampleSdJwt } from '../../lib/sd-jwt';

  const root = document.querySelector<HTMLElement>('[data-decoder]')!;
  const input = root.querySelector<HTMLTextAreaElement>('textarea')!;
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const warnings = root.querySelector<HTMLElement>('[data-warnings]')!;
  const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!;
  const panel = (name: string) => root.querySelector<HTMLElement>(`[data-panel="${name}"]`)!;
  const json = (v: unknown) => JSON.stringify(v, null, 2);
  const panels = ['claims', 'disclosures', 'header', 'payload', 'kb'];

  function cell(text: string, className?: string) {
    const td = document.createElement('td');
    td.textContent = text;
    if (className) td.className = className;
    return td;
  }

  let run = 0;
  async function update() {
    const id = ++run;
    warnings.replaceChildren();
    status.classList.remove('is-error');
    if (!input.value.trim()) {
      panels.forEach((p) => (panel(p).hidden = true));
      status.textContent = 'Paste an SD-JWT, or load the example.';
      return;
    }
    try {
      const r = await decodeSdJwt(input.value);
      if (id !== run) return;

      const shown = r.disclosures.filter((d) => d.path).length;
      status.textContent = `${shown} claim${shown === 1 ? '' : 's'} disclosed · ${r.hiddenCount} kept hidden · ${r.keyBinding ? 'key binding present' : 'no key binding'}`;
      r.warnings.forEach((w) => {
        const li = document.createElement('li');
        li.textContent = w;
        warnings.append(li);
      });

      out('claims').textContent = json(r.claims);
      out('header').textContent = json(r.jwt.header);
      out('payload').textContent = json(r.jwt.payload);
      out('disclosure-count').textContent = `${r.disclosures.length} included`;
      out('disclosures').replaceChildren(
        ...r.disclosures.map((d) => {
          const tr = document.createElement('tr');
          tr.append(
            cell(d.path ?? d.name ?? '(array element)', 'mono accent'),
            cell(typeof d.value === 'string' ? d.value : JSON.stringify(d.value)),
            cell(d.salt.length > 10 ? `${d.salt.slice(0, 8)}…` : d.salt, 'mono muted'),
            cell(d.path ? 'Yes' : 'No', d.path ? 'ok' : 'bad'),
          );
          return tr;
        }),
      );
      if (r.keyBinding) out('kb').textContent = json({ header: r.keyBinding.header, payload: r.keyBinding.payload });

      panel('claims').hidden = false;
      panel('header').hidden = false;
      panel('payload').hidden = false;
      panel('disclosures').hidden = r.disclosures.length === 0;
      panel('kb').hidden = !r.keyBinding;
    } catch (e) {
      if (id !== run) return;
      panels.forEach((p) => (panel(p).hidden = true));
      status.classList.add('is-error');
      status.textContent = e instanceof Error ? e.message : 'Could not decode this input.';
    }
  }

  let timer = 0;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(update, 120);
  });
  root.querySelector('[data-example]')!.addEventListener('click', () => {
    input.value = exampleSdJwt;
    update();
  });
  root.querySelector('[data-clear]')!.addEventListener('click', () => {
    input.value = '';
    update();
    input.focus();
  });
</script>

<style>
  .head {
    position: relative;
    padding-top: 72px;
    padding-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 48px;
  }
  h1 {
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .head__privacy {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text);
  }

  .tool {
    padding-bottom: 112px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px;
  }
  .tool__input {
    flex: 1 1 400px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .tool__input {
      position: sticky;
      top: 24px;
    }
  }
  .tool__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .tool__bar label {
    font-weight: 500;
    font-size: 15px;
  }
  .tool__buttons {
    display: flex;
    gap: 8px;
  }
  .small-btn {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #d9d9de;
    border-radius: 6px;
    background: var(--paper);
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
  }
  .small-btn:hover {
    border-color: var(--ink);
  }
  textarea {
    width: 100%;
    height: 420px;
    resize: vertical;
    padding: 18px;
    border: 1px solid #d9d9de;
    border-radius: 10px;
    background: var(--surface);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink);
    word-break: break-all;
  }
  textarea:focus {
    outline: none;
    border-color: var(--cobalt);
    box-shadow: 0 0 0 3px var(--cobalt-tint);
  }
  .tool__note {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .tool__output {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .tool__status {
    margin: 0;
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--cobalt-tint);
    color: var(--cobalt-ink);
    font-family: var(--mono);
    font-size: 13px;
  }
  .tool__status.is-error {
    background: var(--coral-tint);
    color: var(--coral-ink);
  }
  .tool__warnings {
    margin: 0;
    padding-left: 18px;
    font-size: 14px;
    color: var(--coral-ink);
  }
  .tool__warnings:empty {
    display: none;
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .panel[hidden] {
    display: none;
  }
  .panel__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text);
  }
  .panel pre {
    margin: 0;
    padding: 16px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.7;
  }
  .panel__scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  th {
    text-align: left;
    padding: 10px 16px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }
  :global(.tool td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line-soft);
  }
  :global(.tool tr:last-child td) {
    border-bottom: 0;
  }
  :global(.tool td.mono) {
    font-family: var(--mono);
    font-size: 13px;
  }
  :global(.tool td.accent) {
    color: var(--cobalt-ink);
  }
  :global(.tool td.muted) {
    color: var(--muted);
  }
  :global(.tool td.ok) {
    color: var(--teal-ink);
  }
  :global(.tool td.bad) {
    color: var(--coral-ink);
  }
</style>
