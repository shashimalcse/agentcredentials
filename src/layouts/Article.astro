---
import Base from './Base.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  back: { href: string; label: string };
  date?: Date;
  draft?: boolean;
}

const { title, description, eyebrow, back, date, draft } = Astro.props;
---

<Base title={title} description={description}>
  <article class="article">
    <a href={back.href} class="article__back"><span aria-hidden="true">←</span> {back.label}</a>
    <p class="eyebrow article__eyebrow">
      {eyebrow}
      {draft && <span class="article__draft">Draft</span>}
    </p>
    <h1 class="article__title">{title}</h1>
    <p class="article__lede">{description}</p>
    <div class="article__meta">
      <span><b>{site.author}</b></span>
      {date && <time datetime={date.toISOString()}>{date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>}
    </div>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .article {
    max-width: 728px;
    margin: 0 auto;
    padding: 80px var(--gutter) 112px;
  }
  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 14px;
    color: var(--muted);
  }
  .article__eyebrow {
    margin-top: 24px;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .article__draft {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--coral-tint);
    color: var(--coral-ink);
    letter-spacing: 0.04em;
  }
  .article__title {
    margin: 0;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .article__lede {
    margin: 24px 0 0;
    font-size: 20px;
    color: var(--text);
  }
  .article__meta {
    margin: 40px 0 48px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 14px;
    color: var(--muted);
  }
  .article__meta b {
    color: var(--ink);
    font-weight: 500;
  }
  .article__meta time {
    font-family: var(--mono);
    font-size: 13px;
  }
</style>
