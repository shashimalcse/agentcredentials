---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { url } from '../lib/url';

// By default the promo film, exported from the motion artifact and prepared with scripts/prepare-film.sh.
// Pass file, poster and label to show another recording. Renders nothing until the file exists.
interface Props {
  file?: string;
  poster?: string;
  label?: string;
}
const {
  file = 'video/agent-credentials.mp4',
  poster = 'video/agent-credentials-poster.jpg',
  label = 'Film: Ada registers her agent once, and the agent signs in on its own at Lantern Tickets and two other sites with the same credential.',
} = Astro.props;
const hasFilm = existsSync(join(process.cwd(), 'public', file));
const hasPoster = existsSync(join(process.cwd(), 'public', poster));
---

{
  hasFilm && (
    <figure class="film">
      <video
        class="film__video"
        controls
        playsinline
        preload="metadata"
        width="1920"
        height="1080"
        poster={hasPoster ? url(`/${poster}`) : undefined}
        aria-label={label}
      >
        <source src={url(`/${file}`)} type="video/mp4" />
      </video>
    </figure>
  )
}

<style>
  .film {
    margin: 0 0 48px;
  }
  .film__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #131117;
  }
</style>
