---
import { nav, site } from '../data/site';
import { url } from '../lib/url';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(url(href));
---

<header class="header">
  <div class="container header__inner">
    <a href={url('/')} class="brand" aria-label={`${site.name}, home`}>
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="2" y="5" width="18" height="12" rx="2.5"></rect>
        <circle cx="7.5" cy="11" r="2"></circle>
        <path d="M12 9.5h5M12 12.5h3.5"></path>
      </svg>
      <span>{site.name}</span>
    </a>
    <nav aria-label="Primary" class="nav">
      {
        nav.map((item) => (
          <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={site.github} class="nav__gh">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path>
        </svg>
        GitHub
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: relative;
    border-bottom: 1px solid rgb(10 10 11 / 0.07);
  }
  .header__inner {
    min-height: 64px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 24px;
    font-size: 14px;
  }
  .nav a {
    padding: 10px 0;
    color: var(--text);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--ink);
  }
  .nav a[aria-current='page'] {
    font-weight: 500;
  }
  .nav__gh {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav a.nav__gh {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .nav {
      gap: 0 18px;
      padding-bottom: 6px;
    }
  }
</style>
